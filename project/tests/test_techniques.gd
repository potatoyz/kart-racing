extends RefCounted

const Techniques = preload("res://mechanic/techniques.gd")
const Vehicle = preload("res://mechanic/vehicle.gd")
const Race = preload("res://mechanic/race.gd")
var failures: Array[String] = []
var checks := 0

func expect(value: bool, message: String) -> void:
	checks += 1
	if not value: failures.append(message)

func run_test() -> Dictionary:
	var t = Techniques.new()
	expect(t.press_spray() == "", "no idle small spray")
	t.clear()
	expect(t.bank_drift(0.1,0.01,0.0) == "", "tiny tap cannot farm spray")
	expect(t.bank_drift(0.6,0.1,0.0) == "mini_ready", "valid short drift earns one spray")
	expect(t.press_spray() == "small_boost", "consume single spray")
	t.tick(0.2)
	expect(t.press_spray() == "", "single spray cannot become double")
	t.clear()
	expect(t.bank_drift(0.9,0.25,0.0) == "mini_ready", "long drift without countersteer is single")
	t.clear()
	expect(t.bank_drift(0.9,0.25,0.12) == "double_ready", "long drift with countersteer earns double")
	expect(t.press_spray() == "small_boost", "double starts with first spray")
	t.tick(0.05)
	expect(t.press_spray() == "", "early second tap does not fire immediately")
	expect(t.tick(0.12).has("double_boost"), "early tap buffered to valid second window")
	t.tick(0.2)
	expect(t.press_spray() == "", "double cannot grant third spray")
	t.clear()
	t.bank_drift(1.0,0.3,0.2)
	t.tick(1.16)
	expect(t.press_spray() == "", "first spray expires")
	t.clear()
	t.bank_drift(1.0,0.3,0.2)
	t.press_spray()
	t.tick(0.51)
	expect(t.press_spray() == "", "second spray expires")
	t.clear()
	t.press_spray()
	t.tick(0.13)
	t.bank_drift(0.6,0.1,0.0)
	expect(t.tick(0.01).is_empty(), "expired buffer cannot spend future reward")
	t.clear()
	t.tick(0.2)
	t.observe_ground(false,0.04,0.1,-1.0)
	t.observe_ground(true,0.016,0.06,0.0)
	expect(t.landing_window == 0.0 and not t.air_available, "ground chatter grants no tricks")
	t.clear()
	t.tick(0.1)
	expect(t.observe_ground(false,0.1,1.0,6.0).has("air_ready"), "real takeoff grants air spray")
	expect(t.press_spray() == "air_boost", "air spray works")
	t.tick(0.3)
	t.observe_ground(false,0.3,2.0,0.5)
	expect(t.press_spray() == "", "only one air spray per flight")
	t.buffer = 0.0
	expect(t.observe_ground(true,0.016,0.06,0.0).has("landing_ready"), "true landing grants spray")
	expect(t.press_spray() == "landing_boost" and t.combo_label == "空落连喷", "air to landing chain")
	t.tick(0.2)
	expect(t.press_spray() == "", "landing reward spent exactly once")
	t.clear()
	t.observe_ground(true,0.5,0.06,0.0)
	expect(t.press_spray() == "", "reset is not a landing")
	t.clear()
	t.observe_ground(false,0.3,2.0,7.0)
	t.observe_ground(true,0.1,0.06,0.0)
	t.tick(0.56)
	expect(t.press_spray() == "", "landing window expires")
	for sequence in ["CW","CWW","WCW"]:
		t.clear()
		t.bank_drift(1.0,0.3,0.2)
		if sequence.begins_with("C"): t.remember("nitro_used")
		t.press_spray()
		if sequence == "WCW": t.remember("nitro_used")
		if sequence != "CW":
			t.tick(0.2)
			t.press_spray()
		expect(t.combo_label == sequence + " 连喷", "recognize " + sequence)
	var car = Vehicle.new()
	car.tricks.bank_drift(1.0,0.3,0.2)
	expect(car.use_small_boost() == "small_boost" and car.mini_boost > 0.0, "reward affects actual boost timer")
	car.nitro = 1
	expect(car.use_nitro(), "nitro can chain after small spray")
	car.integrate_motor(0.2,1.0,0.0,false,false)
	expect(car.use_small_boost() == "double_boost" and car.tricks.combo_label == "WCW 连喷", "live vehicle WCW chain")
	car.reset_to(Vector3.ZERO,0.0)
	expect(car.mini_boost == 0.0 and car.tricks.mini_stock == 0 and car.tricks.buffer == 0.0, "reset clears all combo windows")
	car.free()
	var race = Race.new()
	race.save_enabled = false
	race.spawn_racers()
	race.phase = "racing"
	race.racers[0].tricks.bank_drift(0.6,0.1,0.0)
	race.command("pause",{"value":true})
	race._physics_process(2.0)
	expect(race.racers[0].tricks.mini_window == Techniques.MINI_WINDOW, "pause freezes trick deadlines")
	expect(not race.command("small_boost").ok, "pause rejects trick input")
	race.free()
	return {"ok":failures.is_empty(),"checks":checks,"failures":failures,"message":"; ".join(failures)}
