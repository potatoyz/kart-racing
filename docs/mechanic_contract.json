    "air_window",
    "landing_window",
    "airborne",
    "air_time",
    "combo",
    "last_technique"
  ],
  "technique_event_payload": {
    "racer": "racer id",
    "combo": "confirmed combo label",
    "slip": "optional signed angle in radians"
  },
  "presentation_pose": {
    "visual_position": "interpolated global position for presentation only",
    "visual_yaw": "interpolated global yaw for presentation only",
    "physics_state": "position/yaw/travel remain authoritative physics state"
  },
  "presentation_extensions": {
    "cars[].steer_input": "Read-only [-1,1] steering input shared by front-wheel and steering-wheel presentation. No physics change."
  },
  "maps_v11": {
    "car_state": [
      "lap"
    ],
    "select_track": {
      "input": {
        "track_id": "sunny_coast | harbor_loop | ridge_hairpins"
      },
      "allowed_phase": "garage",
      "result": "ok=false preserves existing track on invalid ID or rejected loader"
    },
    "track_changed": "emitted after map assembly, racer reset and selection commit",
    "best": "active map record keyed by speed/item",
    "best_by_track": "all map records keyed by stable track ID and mode",
    "track_geometry": "track.outline and track.bounds are read-only presentation data",
    "profile_version": 2,
    "migration": "legacy best belongs only to sunny_coast"
  }
}
